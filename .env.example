# Copy to .env and fill in only what you need.
# browser_profiles / browser_use / browser_read work without any of this.

# Required for browser_use: the decision model.
# Get one at https://console.typesafe.ai/settings/keys
TYPESAFE_API_KEY=

# --- Optional: the text model -------------------------------------------------
# Jev returns typed decisions and never generates strings, which leaves exactly two
# gaps: it cannot plan a compound goal, and it cannot write a value into a form
# field. One OpenAI-compatible endpoint fills both. Without it the goal is used
# unchanged (no planning) and type_text is not offered at all — clicking, scrolling
# and reading still work.
#
# Works with OpenRouter, OpenAI, Ollama, vLLM, llama.cpp, LM Studio, or anything
# else that speaks /chat/completions.

# JEV_USE_TEXT_MODEL=inception/mercury-2.5
# JEV_USE_TEXT_BASE_URL=https://openrouter.ai/api/v1
# JEV_USE_TEXT_API_KEY=
# Some models emit reasoning tokens that wreck strict JSON parsing; disable them.
# JEV_USE_TEXT_REASONING=none

# A local model, for example:
# JEV_USE_TEXT_MODEL=qwen2.5:7b
# JEV_USE_TEXT_BASE_URL=http://127.0.0.1:11434/v1
# JEV_USE_TEXT_API_KEY=not-needed

# --- Optional overrides -------------------------------------------------------
# CUA_DRIVER_COMMAND=/home/you/.local/bin/cua-driver
